# Copy this file to ".env" in the mvp1/ folder and fill in your own key.
# Never commit the real .env file or paste a real key into chat/docs.
#
# Optional — only used by the Phase 2 Preview page and the FDA label
# summarization on the Patient Dashboard (src/ai_layer.py). The three core
# Phase 1 pages (Patient Dashboard's interaction checks, Pharmacist Review
# Queue, KPI Dashboard) work identically with or without this key set.
ANTHROPIC_API_KEY=

# Optional — defaults to a current Claude model if unset.
MEDGUARDIAN_MODEL=claude-sonnet-5
